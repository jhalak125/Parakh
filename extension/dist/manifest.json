{
  "manifest_version": 3,
  "name": "Parakh (परख) — Review Intelligence",
  "version": "1.0.0",
  "description": "AI-powered review authenticity analyzer for Amazon, Flipkart, Myntra, Meesho, Snapdeal, Nykaa, Ajio, Shopsy & more. Detects fake reviews and surfaces real pros, cons, and dealbreaker alerts.",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.amazon.com/*",
    "*://*.flipkart.com/*",
    "*://*.myntra.com/*",
    "*://*.shopsy.in/*",
    "*://*.meesho.com/*",
    "*://*.snapdeal.com/*",
    "*://*.nykaa.com/*",
    "*://*.nykaafashion.com/*",
    "*://*.ajio.com/*",
    "*://*.tatacliq.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Parakh Review Analyzer",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "public/icons/icon-16.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  }
}
